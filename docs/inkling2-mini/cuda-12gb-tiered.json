{
  "backend": "cuda",
  "exe": "build/tintero",
  "args": [
    "--model",
    "models/Inkling-2-Mini-IQ4_NL.gguf",
    "--max-context",
    "32768",
    "--chunk",
    "512"
  ],
  "env": {
    "IK2_KV": "fp4-global",
    "IK2_GPU_SERVED": "1",
    "IK2_HOST": "pinned",
    "IK2_BATCH_PREFILL": "1"
  },
  "tokenizer": "ik2/tokenizer",
  "model_name": "inkling-2-mini"
}
